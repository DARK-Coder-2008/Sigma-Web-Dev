rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile: Anyone can read public leaderboard info, but only user can write their own
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false; // Disallow accidental user deletion
    }
    
    // User lesson progress: strictly isolated to the user
    match /user_progress/{progressId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
    
    // Quiz submissions: logged-in users can record scores
    match /quiz_attempts/{attemptId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
    
    // Public Leaderboard: read-only for public, updated by server/authenticated users
    match /leaderboard/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}