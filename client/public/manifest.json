{
  "id": "sigma-web-dev-course-app",
  "name": "Sigma Web Dev - Learn Web Development",
  "short_name": "SigmaDev",
  "description": "Full-Stack Web Development Course with 139 Chapters, Theory Summaries, Code Lab & AI Chatbot",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait-primary",
  "background_color": "#090d16",
  "theme_color": "#a855f7",
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "education",
    "developer tools",
    "productivity"
  ],
  "iarc_rating_id": "e58c174a-81d2-4ba1-b4f0-45929b9f7a77",
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://dark-coder-2008.github.io/Sigma-Web-Dev/manifest.json"
    }
  ],
  "scope_extensions": [
    {
      "origin": "https://dark-coder-2008.github.io"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "name": "Web Code Files",
      "icons": [
        {
          "src": "./icon-192.png",
          "sizes": "192x192"
        }
      ],
      "accept": {
        "text/html": [".html", ".htm"],
        "text/css": [".css"],
        "text/javascript": [".js", ".mjs"]
      }
    }
  ],
  "icons": [
    {
      "src": "./icon-192.png",
      "type": "image/png",
      "sizes": "192x192",
      "purpose": "any maskable"
    },
    {
      "src": "./icon-512.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "any maskable"
    },
    {
      "src": "./icon.svg",
      "type": "image/svg+xml",
      "sizes": "512x512",
      "purpose": "any"
    }
  ],
  "screenshots": [
    {
      "src": "./screenshot-mobile.png",
      "type": "image/png",
      "sizes": "540x960",
      "form_factor": "narrow",
      "label": "Sigma Web Dev Mobile View"
    },
    {
      "src": "./screenshot-desktop.png",
      "type": "image/png",
      "sizes": "1280x720",
      "form_factor": "wide",
      "label": "Sigma Web Dev Desktop View"
    }
  ],
  "shortcuts": [
    {
